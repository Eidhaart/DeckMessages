# ~/.zshrc - NETDECK//OS shell (installed by netdeck/zsh/install-zsh.sh)
# Put your own additions in ~/.zshrc.local so updates never overwrite them.

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="netrunner"

# oh-my-zsh behaviour
HYPHEN_INSENSITIVE="true"
COMPLETION_WAITING_DOTS="%F{red}…%f"
HIST_STAMPS="yyyy-mm-dd"
zstyle ':omz:update' mode reminder

plugins=(git sudo extract colored-man-pages command-not-found history-substring-search
         zsh-autosuggestions zsh-syntax-highlighting)
(( $+commands[fzf] )) && plugins+=(fzf)
(( $+commands[zoxide] )) && plugins+=(zoxide)

source "$ZSH/oh-my-zsh.sh"

# history
HISTSIZE=50000
SAVEHIST=50000
setopt hist_ignore_all_dups hist_reduce_blanks share_history inc_append_history

# ↑/↓ search history for what you've typed so far
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down
bindkey '^[OA' history-substring-search-up
bindkey '^[OB' history-substring-search-down
HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_FOUND="fg=${ND[acc]},bold"
HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_NOT_FOUND="fg=${ND[bad]},bold"

# completion menu in deck colors
zstyle ':completion:*' menu select
zstyle ':completion:*' list-colors "ma=48;2;0;0;0;38;2;$((16#${ND[acc]:1:2}));$((16#${ND[acc]:3:2}));$((16#${ND[acc]:5:2}));1"
zstyle ':completion:*:descriptions' format "%F{${ND[pri]}}◢ %d%f"
zstyle ':completion:*:warnings' format "%F{${ND[bad]}}✗ no matches%f"

# deck shortcuts
alias deck='netdeck'
alias jackin='netdeck-switch deck'
alias skin='deckskin'
if (( $+commands[eza] )); then
  alias ls='eza --group-directories-first'
  alias ll='eza -la --group-directories-first --git'
  alias tree='eza --tree'
else
  alias ll='ls -lah --color=auto'
fi
(( $+commands[batcat] )) && ! (( $+commands[bat] )) && alias bat='batcat'
(( $+commands[fdfind] )) && ! (( $+commands[fd] )) && alias fd='fdfind'

# one quiet line when a terminal opens  (NETDECK_GREETING=0 in ~/.zshrc.local turns it off)
if [[ -o interactive && ${NETDECK_GREETING:-1} != 0 && -z $_ND_GREETED ]]; then
  typeset -g _ND_GREETED=1
  if [[ -n $NETDECK ]]; then
    print -P "%F{${ND[pri]}}◢ RAW LINK%f %F{${ND[line]}}//%f %F{${ND[dim]}}type%f %F{${ND[hi]}}exit%f %F{${ND[dim]}}to jack back into the deck%f"
  else
    print -P "%F{${ND[pri]}}◢ NETDECK%f %F{${ND[line]}}//%f %F{${ND[acc]}}%n@%m%f %F{${ND[line]}}//%f %F{${ND[dim]}}zsh ${ZSH_VERSION} // %D{%d.%m.%Y %H:%M} // link stable%f"
  fi
fi

[[ -r ~/.zshrc.local ]] && source ~/.zshrc.local
